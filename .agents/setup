#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

bun_version="1.3.13"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

echo "==> Ensuring Bun $bun_version"
if [[ ! -x "$BUN_INSTALL/bin/bun" ]] || [[ "$($BUN_INSTALL/bin/bun --version)" != "$bun_version" ]]; then
  curl -fsSL https://bun.sh/install | bash -s -- "bun-v$bun_version"
fi

profile_marker="# Quincy Bun toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# Quincy Bun toolchain
export BUN_INSTALL="$HOME/.bun"
case ":$PATH:" in
  *":$BUN_INSTALL/bin:"*) ;;
  *) export PATH="$BUN_INSTALL/bin:$PATH" ;;
esac
EOF
fi

echo "==> Installing dependencies"
time bun install --frozen-lockfile

echo "==> Setup complete"
